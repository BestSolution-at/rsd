	@ServerResponseFilter
	public void whatever(ContainerResponseContext context) {
		System.err.println("=====> RESPONSE STATUS: " + context.getStatus());
		if (context.hasEntity()) {
			Object entity = context.getEntity();
			String body = entity != null ? entity.toString() : "";
			System.err.println("=====> RESPONSE BODY: " + body);
		}
	}
