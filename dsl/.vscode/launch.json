// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "GenerateTestFiles",
            "request": "launch",
            "mainClass": "dev.rsdlang.GenerateTestFiles",
            "projectName": "java-avro",
						"vmArgs": "-Dorg.apache.avro.SERIALIZABLE_PACKAGES=dev.rsdlang.sample.avro"
        },
        {
            "type": "java",
            "name": "EnumSample",
            "request": "launch",
            "mainClass": "dev.rsdlang.EnumSample",
            "projectName": "java-avro"
        },
        {
            "type": "java",
            "name": "ParseSample",
            "request": "launch",
            "mainClass": "dev.rsdlang.ParseSample",
            "projectName": "java-avro"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "dev.rsdlang.Main",
            "projectName": "java-avro"
        },
        {
            "type": "java",
            "name": "AvroGeneric",
            "request": "launch",
            "mainClass": "at.bestsolution.AvroGeneric",
            "projectName": "avro-playground"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "at.bestsolution.Main",
            "projectName": "avro-playground",
						"vmArgs": "-Dorg.apache.avro.SERIALIZABLE_PACKAGES=example.avro"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "at.bestsolution.Main",
            "projectName": "hardwood-playground"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "at.bestsolution.Main",
            "projectName": "msg-package-java"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "dev.rsdlang.Main",
            "projectName": "java-client"
        },
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "dev.rsdlang.Main",
            "projectName": "person-java-client"
        },
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/extension"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/language/out/**/*.js",
                "${workspaceFolder}/packages/extension/out/**/*.js"
            ]
        },
        {
            "name": "Attach to Language Server",
            "type": "node",
            "port": 6009,
            "request": "attach",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/packages/language/out/**/*.js",
                "${workspaceFolder}/packages/extension/out/**/*.js",
                "${workspaceFolder}/node_modules/langium"
            ]
        }
    ]
}
